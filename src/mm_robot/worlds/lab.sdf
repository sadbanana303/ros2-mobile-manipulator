<model name="cube"><pose>2.05 0 0.325 0 0 0</pose><link name="l"><inertial><mass>0.05</mass><inertia><ixx>2.1e-5</ixx><iyy>2.1e-5</iyy><izz>2.1e-5</izz></inertia></inertial>
<collision name="c"><geometry><box><size>0.05 0.05 0.05</size></box></geometry><surface><friction><ode><mu>10.0</mu><mu2>10.0</mu2></ode></friction></surface></collision>
<visual name="v"><geometry><box><size>0.05 0.05 0.05</size></box></geometry><material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material></visual></link></model>
</world></sdf>
