<?xml version="1.0"?>
<sdf version="1.9"><world name="lab">
<physics name="p" type="ode"><max_step_size>0.004</max_step_size><real_time_factor>1.0</real_time_factor></physics>
<plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
<plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
<plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
<plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
<light type="directional" name="sun"><pose>0 0 10 0 0 0</pose><direction>-0.5 0.1 -0.9</direction><diffuse>1 1 1 1</diffuse><cast_shadows>false</cast_shadows></light>
<model name="ground"><static>true</static><link name="l"><collision name="c"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision><visual name="v"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry><material><ambient>.7 .7 .7 1</ambient><diffuse>.7 .7 .7 1</diffuse></material></visual></link></model>
<model name="wall_n"><static>true</static><pose>1.25 4 0.5 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>5.6 0.1 1</size></box></geometry></collision><visual name="v"><geometry><box><size>5.6 0.1 1</size></box></geometry></visual></link></model>
<model name="wall_s"><static>true</static><pose>1.25 -2.5 0.5 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>5.6 0.1 1</size></box></geometry></collision><visual name="v"><geometry><box><size>5.6 0.1 1</size></box></geometry></visual></link></model>
<model name="wall_w"><static>true</static><pose>-1.5 0.75 0.5 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>0.1 6.6 1</size></box></geometry></collision><visual name="v"><geometry><box><size>0.1 6.6 1</size></box></geometry></visual></link></model>
<model name="wall_e"><static>true</static><pose>4 0.75 0.5 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>0.1 6.6 1</size></box></geometry></collision><visual name="v"><geometry><box><size>0.1 6.6 1</size></box></geometry></visual></link></model>
<model name="table_a"><static>true</static><pose>2.2 0 0.15 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>0.5 0.6 0.3</size></box></geometry></collision><visual name="v"><geometry><box><size>0.5 0.6 0.3</size></box></geometry></visual></link></model>
<model name="table_b"><static>true</static><pose>0 2.2 0.15 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>0.6 0.5 0.3</size></box></geometry></collision><visual name="v"><geometry><box><size>0.6 0.5 0.3</size></box></geometry></visual></link></model>
